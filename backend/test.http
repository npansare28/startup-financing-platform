### ==========================================
### STARTUP FINANCING PLATFORM - API TESTS
### ==========================================


### ==========================================
### 1. HOME
### ==========================================

GET http://127.0.0.1:5000/


### ==========================================
### 2. API TEST
### ==========================================

GET http://127.0.0.1:5000/api/test


### ==========================================
### 3. SIGNUP - PITCHER
### ==========================================

### SIGNUP - FOUNDER

POST http://127.0.0.1:5000/api/auth/signup
Content-Type: application/json

{
    "email": "nikhil@gmail.com",
    "password": "test123",
    "role": "founder"
}
### ==========================================
### 4. SIGNUP - INVESTOR
### ==========================================

### SIGNUP - INVESTOR

POST http://127.0.0.1:5000/api/auth/signup
Content-Type: application/json

{
    "email": "investor@gmail.com",
    "password": "test123",
    "role": "investor"
}

### ==========================================
### 5. LOGIN - PITCHER
### ==========================================

POST http://127.0.0.1:5000/api/auth/login
Content-Type: application/json

{
    "email": "nikhil@gmail.com",
    "password": "test123"
}


### ==========================================
### 6. LOGIN - INVESTOR
### ==========================================

POST http://127.0.0.1:5000/api/auth/login
Content-Type: application/json

{
    "email": "investor@gmail.com",
    "password": "test123"
}


### ==========================================
### 7. AUTH CHECK
### Replace YOUR_TOKEN with the token
### received from LOGIN
### ==========================================

GET http://127.0.0.1:5000/api/auth/check
Authorization: Bearer YOUR_TOKEN


### ==========================================
### 8. PROFILE
### Replace YOUR_TOKEN
### ==========================================

GET http://127.0.0.1:5000/api/profile
Authorization:JhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..qMhCj70ahnWGHg0oPj4jslAGkfae6NcvH1hqQSYMRAc


